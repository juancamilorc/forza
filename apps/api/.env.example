# ── Supabase ─────────────────────────────────────────────────
SUPABASE_URL=https://[PROJECT_REF].supabase.co
SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ── JWT ──────────────────────────────────────────────────────
JWT_SECRET=una-clave-secreta-larga-y-aleatoria
JWT_EXPIRES_IN=7d

# ── Server ───────────────────────────────────────────────────
# Railway inyecta PORT automáticamente — no lo configures manualmente en Railway
API_PORT=3000
NODE_ENV=production

# ── CORS ─────────────────────────────────────────────────────
# URL del frontend en Vercel (sin slash final)
FRONTEND_URL=https://forza-app.vercel.app

# Orígenes permitidos por CORS, separados por comas (vacío = lista por defecto)
CORS_ORIGINS=

# --- Entorno de demostración (dejar vacío en el resto de ambientes) ---
# El modo demo solo se activa si DEMO_MODE=true Y SUPABASE_URL == DEMO_SUPABASE_URL
DEMO_MODE=
DEMO_SUPABASE_URL=
# Saltos de proxy confiables para el límite de peticiones (Render: 1)
TRUST_PROXY_HOPS=
# Valor de la clase de prueba (opcional)
TRIAL_PRICE=
